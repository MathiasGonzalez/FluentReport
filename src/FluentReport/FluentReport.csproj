<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>FluentReport</PackageId>
    <Description>PDF renderer for FluentReport: a fluent C# API for reports with real pagination (split columns, text and tables with repeated headers), built on SkiaSharp. Linux compatible.</Description>
    <PackageTags>pdf;report;fluent;skiasharp</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <!-- DejaVu Sans: fallback when the system has no usable font (e.g. Linux containers without fonts). -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\DejaVuSans.ttf" LogicalName="FluentReport.Fonts.DejaVuSans.ttf" />
    <EmbeddedResource Include="Fonts\DejaVuSans-Bold.ttf" LogicalName="FluentReport.Fonts.DejaVuSans-Bold.ttf" />
    <None Include="Fonts\LICENSE-DejaVu.txt" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FluentReport.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluentReport.Core\FluentReport.Core.csproj" />
  </ItemGroup>
</Project>
