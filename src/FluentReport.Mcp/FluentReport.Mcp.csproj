<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Distribute as a dotnet global tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fluentreport-mcp</ToolCommandName>
    <!-- NuGet metadata -->
    <PackageId>FluentReport.Mcp</PackageId>
    <Version>1.0.0</Version>
    <Authors>Mathías González Benítez</Authors>
    <Description>MCP server for FluentReport — exposes report generation, schema validation, and schema tools to AI coding agents via the Model Context Protocol.</Description>
    <PackageTags>mcp;report;pdf;fluent;ai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MathiasGonzalez/FluentReport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentReport\FluentReport.csproj" />
    <ProjectReference Include="..\FluentReport.Html\FluentReport.Html.csproj" />
    <ProjectReference Include="..\FluentReport.Excel\FluentReport.Excel.csproj" />
    <ProjectReference Include="..\FluentReport.Schema\FluentReport.Schema.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
</Project>
