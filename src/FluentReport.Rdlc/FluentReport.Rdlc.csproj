<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>FluentReport.Rdlc</PackageId>
    <Description>RDLC / SSRS importer for FluentReport: turns .rdlc report definitions and their data into documents that render to PDF, HTML and Excel, without ReportViewer. Supports row groups with subtotals, sorting, filters, Format, borders, visibility, rectangles, page numbers and VB expressions.</Description>
    <PackageTags>rdlc;ssrs;reportviewer;report;pdf;fluent</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FluentReport.Rdlc.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluentReport.Core\FluentReport.Core.csproj" />
  </ItemGroup>
</Project>
